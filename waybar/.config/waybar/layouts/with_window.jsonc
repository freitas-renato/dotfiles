{
    "layer" : "top",
    "position" : "top",
    // "width" : 1920,
    "margin" : "8 0 0 0",

    "group/gleft1" : {
        "orientation": "horizontal",
        "modules" : [
            "hyprland/workspaces"
        ]
    },

    "group/gleft2" : {
        "orientation": "horizontal",
        "modules" : [
            "hyprland/window"
        ]
    },


    "group/gright1" : {
        "orientation": "horizontal",
        "modules" : [
            "backlight", "memory", "temperature", "battery", "hyprland/submap"
        ]
    },

    "group/gright2" : {
        "orientation": "horizontal",
        "modules" : [
            "pulseaudio", "bluetooth", "network", "tray"
        ]
    },

    // "modules-left"   : ["custom/start", "group/gleft1", "group/gleft2"],
    "modules-left"   : ["group/gleft1", "group/gleft2"],
    "modules-center" : ["clock"],
    "modules-right"  : [ "group/gright2", "group/gright1", "custom/ctlcenter"],

    "include": [ "~/.config/waybar/modules.jsonc" ]
}
